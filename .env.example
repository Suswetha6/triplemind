# Copy to .env for local runs. Never commit a real .env -- it is gitignored.
#
# The Groq API key is NOT configured here: it is supplied by the end user in
# the Settings modal at runtime and forwarded per request. The deployment
# holds no provider credentials of its own.

# Host port bindings (change if these clash with something already running).
FRONTEND_PORT=8080
BACKEND_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=4318

# Build metadata, normally injected by CI.
APP_VERSION=dev
GIT_SHA=local

# Backend tuning.
TM_RATE_LIMIT_REQUESTS=120

# Set to http://tempo:4318 when running the observability profile to turn on
# tracing; empty disables the exporter entirely.
TM_OTEL_EXPORTER_OTLP_ENDPOINT=

# Grafana admin password for the local observability profile only.
GRAFANA_PASSWORD=admin
